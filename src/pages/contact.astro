---
// main layout
import BaseLayout from "@layouts/BaseLayout.astro";

// components
import Button from "@components/Button/Button.astro";
---

<BaseLayout
    title="Contact Monica"
    description="Get in touch! Contact Monica Miller"
>
    <div class="container mx-auto pt-36 md:pt-44">
        <h1 class="h1 text-center">Contact Me!</h1>
        <p class="description mx-auto mt-6 max-w-2xl text-center">
            I'd love to hear from you. Email me at <a
                href="mailto:hello@monimiller.com"
                class="text-primary-600">hello@monimiller.com</a
            >.
        </p>
        <div class="mt-10 flex justify-center">
            <Button
                variant="primary"
                href="mailto:hello@monimiller.com"
                arrow="right"
            >
                Send an email
            </Button>
        </div>
    </div>
</BaseLayout>
